#include <mem.h>

/delete-node/ &sd0;
/delete-node/ &vcc_sd0;
/delete-node/ &vccq_sd0;
/delete-node/ &gpio5;

/ {
	domu_configs {
		#address-cells = <1>;
		#size-cells = <0>;

		/* it is needed only for correct filling structures by macros */
		iomem: iomem {
			compatible = "xen,domu-iomem";
			#iomem-cells = <3>;
		};

		domu@1 {
			/*
			 * Most of the properties of this one and children nodes are default and don't appear
			 * in the resulting dts.
			 *
			 * Refer to 'xen,domu.yaml', 'xen,domu-vbd.yaml' and 'xen,domu-vif.yaml' for details.
			 */
			compatible = "xen,domu";
			machine_dt_compat = "renesas,r8a7795";

			reg = <0x1>;
			mem_size = <DT_SIZE_M(2048)>;
			max_vcpus = <4>;

			cmdline = "console=hvc0 clk_ignore_unused root=/dev/nfs rw rootwait nfsroot=10.22.64.15:/home/testrpi1/nfs/domd,vers=3 ip=dhcp pvrsrvkm.DriverMode=0";

