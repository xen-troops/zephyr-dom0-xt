#include <mem.h>

/ {
	domu_configs {
		#address-cells = <1>;
		#size-cells = <0>;

		/* it is needed only for correct filling structures by macros */
		iomem: iomem {
			compatible = "xen,domu-iomem";
			#iomem-cells = <3>;
		};

		domu@1 {
			/*
			 * Most of the properties of this one and children nodes are default and don't appear
			 * in the resulting dts.
			 *
			 * Refer to 'xen,domu.yaml', 'xen,domu-vbd.yaml' and 'xen,domu-vif.yaml' for details.
			 */
			compatible = "xen,domu";
			machine_dt_compat = "renesas,r8a77961";

			reg = <0x1>;
			mem_size = <DT_SIZE_M(2048)>;
			cmdline = "clk_ignore_unused root=/dev/nfs rw rootwait console=hvc0 pvrsrvkm.DriverMode=0";

			max_vcpus = <4>;

			domu-irqs =
				// gpio@e6050000
				<36>,
				// gpio@e6051000
				<37>,
				// gpio@e6052000
				<38>,
				// gpio@e6053000
				<39>,
				// gpio@e6054000
				<40>,
				// gpio@e6055000
				<41>,
				// gpio@e6055400
				<42>,
				// gpio@e6055800
				<43>,
				// interrupt-controller@e61c0000
				<32>, <33>, <34>, <35>, <193>, <50>,
				// i2c@e6510000
				<318>,
				// i2c@e66d8000
				<51>,
				// crypto@e6601000
				<103>,
				// ethernet@e6800000
				<71>, <72>, <73>, <74>, <75>, <76>, <77>, <78>, <79>, <80>, <81>, <82>, <83>, <84>, <85>, <86>, <87>, <88>, <89>, <90>, <91>, <92>, <93>, <94>, <95>,
				// serial@e6e68000
				<185>,
				// csi2@fea80000
				<216>,
				// csi2@feaa0000
				<278>,
				// video@e6ef0000
				<220>,
				// video@e6ef1000
				<221>,
				// video@e6ef2000
				<222>,
				// video@e6ef3000
				<223>,
				// video@e6ef4000
				<206>,
				// video@e6ef5000
				<207>,
				// video@e6ef6000
				<208>,
				// video@e6ef7000
				<203>,
				// dma-controller@e6700000
				<231>, <232>, <233>, <234>, <235>, <236>, <237>, <238>, <239>, <240>, <241>, <242>, <243>, <244>, <245>, <246>, <247>,
				// dma-controller@e7300000
				<251>, <345>, <252>, <346>, <248>, <340>, <341>, <342>, <343>, <344>, <249>, <250>, <347>, <348>, <349>, <350>, <351>,
				// dma-controller@e7310000
				<448>, <449>, <450>, <451>, <452>, <453>, <454>, <455>, <456>, <457>, <458>, <459>, <460>, <461>, <462>, <463>, <429>,
				// dma-controller@ec700000
				<352>, <353>, <354>, <355>, <356>, <357>, <358>, <359>, <360>, <361>, <362>, <363>, <364>, <365>, <366>, <367>, <382>,
				// dma-controller@ec720000
				<383>, <368>, <369>, <370>, <371>, <372>, <373>, <374>, <375>, <376>, <377>, <378>, <379>, <380>, <381>, <414>, <415>,
				// dma-controller@e65a0000
				<141>,
				// dma-controller@e65b0000
				<142>,
				// usb@e6590000
				<139>,
