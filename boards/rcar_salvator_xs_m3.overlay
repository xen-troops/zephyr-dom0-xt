				"/x12",
				"/x21-clock",
				"/x22-clock",
				"/x23-clock",
				"/vspm_if",
				"/usb3s0",
				"/usb_extal",
				"/reserved-memory",
				"/mmngr",
				"/mmngrbuf",
				"/__symbols__";

			dtdevs =
				"/soc/ethernet@e6800000",
				"/soc/dma-controller@e6700000",
				"/soc/dma-controller@e7300000",
				"/soc/dma-controller@e7310000",
				"/soc/dma-controller@ec700000",
